{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:metadata:timestamp",
  "type": "object",
  "properties": {
    "signed": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "role": {
          "const": "timestamp"
        },
        "product": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "scope": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "snapshot": {
          "$ref": "urn:pinvou:upgrade:v1:common#/$defs/metadataReference"
        }
      },
      "required": [
        "protocolVersion",
        "role",
        "product",
        "component",
        "scope",
        "version",
        "issuedAt",
        "expiresAt",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "items": {
        "$ref": "urn:pinvou:upgrade:v1:common#/$defs/signature"
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "signed",
    "signatures"
  ],
  "additionalProperties": false
}
