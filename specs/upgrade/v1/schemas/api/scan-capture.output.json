{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:api:scan-capture.output",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._-]"
      }
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/hash"
    }
  },
  "required": [
    "name",
    "size",
    "sha256"
  ],
  "additionalProperties": false
}
