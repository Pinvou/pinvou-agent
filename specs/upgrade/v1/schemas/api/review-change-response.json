{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:api:review-change-response",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "change": {
      "$ref": "urn:pinvou:upgrade:v1:api:approved-change"
    },
    "approvalEvidenceId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "disposition": {
      "enum": [
        "approved",
        "rejected",
        "awaiting-second-review"
      ]
    }
  },
  "required": [
    "protocolVersion",
    "requestId",
    "change",
    "approvalEvidenceId",
    "disposition"
  ],
  "additionalProperties": false
}
