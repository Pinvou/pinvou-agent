{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:api:forward-edge",
  "type": "object",
  "properties": {
    "fromSourceProfileId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/hash"
    },
    "releaseTargetId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "releaseTargetRevision": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/positive"
    },
    "toCanonicalAppVersion": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/version"
    },
    "packageId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "packageSha256": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/hash"
    },
    "transformId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "transformRevision": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/positive"
    },
    "allowedChannels": {
      "type": "array",
      "items": {
        "$ref": "urn:pinvou:upgrade:v1:common#/$defs/channel"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true
    }
  },
  "required": [
    "fromSourceProfileId",
    "releaseTargetId",
    "releaseTargetRevision",
    "toCanonicalAppVersion",
    "packageId",
    "packageSha256",
    "transformId",
    "transformRevision",
    "allowedChannels"
  ],
  "additionalProperties": false
}
