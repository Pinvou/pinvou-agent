        },
        "state": {
          "const": "processing"
        },
        "original": {
          "$ref": "urn:pinvou:upgrade:v1:api:floor-draft.locator"
        },
        "request": {
          "$ref": "urn:pinvou:upgrade:v1:api:floor-draft.save-request"
