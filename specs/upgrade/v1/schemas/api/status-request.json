{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:api:status-request",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "product": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "component": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "installationScopeId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "purpose": {
      "enum": [
        "preinstall",
        "install",
        "activate"
      ]
    },
    "authorizationJti": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "consumeKey": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "transactionId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "consumeRequestDigest": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/hash"
    },
    "recoverySecret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "protocolVersion",
    "product",
    "component",
    "installationScopeId",
    "purpose",
    "authorizationJti",
    "consumeKey",
    "transactionId",
    "consumeRequestDigest",
    "recoverySecret"
  ],
  "additionalProperties": false
}
