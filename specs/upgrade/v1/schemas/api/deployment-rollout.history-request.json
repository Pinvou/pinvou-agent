{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:api:deployment-rollout.history-request",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "scope": {
      "$ref": "urn:pinvou:upgrade:v1:api:deployment-rollout.scope"
    },
    "deploymentId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "beforeSequence": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "protocolVersion",
    "scope",
    "deploymentId",
    "beforeSequence",
    "pageCount"
  ],
  "additionalProperties": false,
  "description": "Descending original authenticated T05 audit sequence; beforeSequence is exclusive. It is not a new order, client timestamp or acceptance time."
}
