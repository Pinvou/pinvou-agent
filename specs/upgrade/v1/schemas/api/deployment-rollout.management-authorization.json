{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:api:deployment-rollout.management-authorization",
  "type": "object",
  "properties": {
    "recordKind": {
      "const": "authorization"
    },
    "recordId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/hash"
    }
  },
  "required": [
    "recordKind",
    "recordId",
    "revision",
    "sha256"
  ],
  "additionalProperties": false,
  "description": "T05 read reference uses recordKind/recordId, unlike the kind/id operation references above."
}
