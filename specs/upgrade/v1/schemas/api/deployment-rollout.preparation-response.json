{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:api:deployment-rollout.preparation-response",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "change": {
      "allOf": [
        {
          "$ref": "urn:pinvou:upgrade:v1:api:deployment-rollout.change-ref"
        },
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            }
          }
        }
      ],
      "description": "Original preparation revision1, even after reviews advance the current Change."
    }
  },
  "required": [
    "protocolVersion",
    "change"
  ],
  "additionalProperties": false,
  "description": "Direct owner preparation ACK, not an HTTP result/requestId wrapper."
}
