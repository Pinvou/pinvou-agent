        {
          "$ref": "urn:pinvou:upgrade:v1:common#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "revision",
    "recordKind",
    "projectionOwner",
    "product",
    "materialId",
    "materialSha256",
    "rootVersion",
    "rootBodySha256",
