{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:api:reconciliation-action-response",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "taskId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "taskRevision": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/integer"
    },
    "disposition": {
      "enum": [
        "recorded",
        "protection-retained",
        "reconciled"
      ]
    }
  },
  "required": [
    "protocolVersion",
    "requestId",
    "taskId",
    "taskRevision",
    "disposition"
  ],
  "additionalProperties": false
}
