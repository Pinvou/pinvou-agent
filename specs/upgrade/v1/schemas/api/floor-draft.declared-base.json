{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:api:floor-draft.declared-base",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "$ref": "urn:pinvou:upgrade:v1:api:floor-draft.scope"
    },
    "floorId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/identifier"
    },
    "revision": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/positive"
    },
    "supportFloorVersion": {
      "type": "string",
      "allOf": [
        {
          "$ref": "urn:pinvou:upgrade:v1:common#/$defs/version"
        }
      ],
      "maxLength": 65536
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "floorId",
    "revision",
    "supportFloorVersion"
  ],
  "additionalProperties": false,
  "description": "Explicit unverified declared base only, never the current active floor or authenticated publication. Same full scope required."
}
