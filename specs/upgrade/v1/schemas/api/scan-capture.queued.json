{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:api:scan-capture.queued",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "resultId": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/hash"
    },
    "state": {
      "const": "queued"
    },
    "queuedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "originalSHA256": {
      "$ref": "urn:pinvou:upgrade:v1:common#/$defs/hash"
    }
  },
  "required": [
    "protocolVersion",
    "resultId",
    "state",
    "queuedAt",
    "originalSHA256"
  ],
  "additionalProperties": false
}
