{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:credentials:helper-cleanup",
  "type": "object",
  "properties": {
    "signed": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "role": {
          "const": "helper-cleanup"
        },
        "product": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "scope": {
          "type": "object",
          "properties": {
            "installationScopeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "channel": {
              "enum": [
                "stable",
                "beta",
                "internal"
              ]
            },
            "channelRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "targetKey": {
              "enum": [
                "windows-x86_64-nsis-perMachine",
                "linux-x86_64-deb-perMachine",
                "linux-arm64-deb-perMachine",
                "macos-universal-dmg-perMachine"
              ]
            }
          },
          "required": [
            "installationScopeId",
            "channel",
            "channelRevision",
            "targetKey"
          ],
          "additionalProperties": false
        },
        "credentialType": {
          "const": "helper-cleanup"
        },
        "aud": {
          "const": "upgrade-helper-cleanup"
        },
        "purpose": {
          "const": "cleanup"
        },
        "credentialPurpose": {
          "const": "cleanup"
        },
        "jti": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "signingKeyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nbf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "installId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "registryVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "selectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "beforeFactsDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "afterFactsDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preparation": {
          "$ref": "urn:pinvou:upgrade:v1:common#/$defs/preparation"
        },
        "deletionSet": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "identity": {
                "$ref": "urn:pinvou:upgrade:v1:common#/$defs/nativeIdentity"
              },
              "protectedPathId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              }
            },
            "required": [
              "identity",
              "protectedPathId"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 4096
        }
      },
      "required": [
        "protocolVersion",
        "role",
        "product",
        "component",
        "scope",
        "credentialType",
        "aud",
        "purpose",
        "credentialPurpose",
        "jti",
        "signingKeyId",
        "iat",
        "nbf",
        "exp",
        "installId",
        "registryVersion",
        "selectionGeneration",
        "beforeFactsDigest",
        "afterFactsDigest",
        "preparation",
        "deletionSet"
      ],
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "items": {
        "$ref": "urn:pinvou:upgrade:v1:common#/$defs/signature"
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "signed",
    "signatures"
  ],
  "additionalProperties": false
}
