{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:credentials:activate-transaction-event",
  "type": "object",
  "properties": {
    "signed": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "role": {
          "const": "activate-transaction-event"
        },
        "product": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "scope": {
          "type": "object",
          "properties": {
            "installationScopeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "channel": {
              "enum": [
                "stable",
                "beta",
                "internal"
              ]
            },
            "channelRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "targetKey": {
              "enum": [
                "windows-x86_64-nsis-perMachine",
                "linux-x86_64-deb-perMachine",
                "linux-arm64-deb-perMachine",
                "macos-universal-dmg-perMachine"
              ]
            }
          },
          "required": [
            "installationScopeId",
            "channel",
            "channelRevision",
            "targetKey"
          ],
          "additionalProperties": false
        },
        "credentialType": {
          "const": "activate-transaction-event"
        },
        "aud": {
          "const": "update-events"
        },
        "purpose": {
          "const": "activate"
        },
        "credentialPurpose": {
          "const": "activate"
        },
        "jti": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "signingKeyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nbf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "installId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "decisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "decisionRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authorizationJti": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "transactionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "transactionStartedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "denyRevisionAtIssue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eventModel": {
          "const": "transaction-v1"
        },
        "allowedEvents": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "eventNotAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "protocolVersion",
        "role",
        "product",
        "component",
        "scope",
        "credentialType",
        "aud",
        "purpose",
        "credentialPurpose",
        "jti",
        "signingKeyId",
        "iat",
        "nbf",
        "exp",
        "installId",
        "decisionId",
        "decisionRevision",
        "authorizationJti",
        "transactionId",
        "transactionStartedAt",
        "denyRevisionAtIssue",
        "eventModel",
        "allowedEvents",
        "eventNotAfter"
      ],
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "items": {
        "$ref": "urn:pinvou:upgrade:v1:common#/$defs/signature"
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "signed",
    "signatures"
  ],
  "additionalProperties": false
}
