{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:credentials:reconciliation-action",
  "type": "object",
  "properties": {
    "signed": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "role": {
          "const": "reconciliation-action"
        },
        "product": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "scope": {
          "type": "object",
          "properties": {
            "installationScopeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "channel": {
              "enum": [
                "stable",
                "beta",
                "internal"
              ]
            },
            "channelRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "targetKey": {
              "enum": [
                "windows-x86_64-nsis-perMachine",
                "linux-x86_64-deb-perMachine",
                "linux-arm64-deb-perMachine",
                "macos-universal-dmg-perMachine"
              ]
            }
          },
          "required": [
            "installationScopeId",
            "channel",
            "channelRevision",
            "targetKey"
          ],
          "additionalProperties": false
        },
        "credentialType": {
          "const": "reconciliation-action"
        },
        "aud": {
          "const": "upgrade-task-action"
        },
        "purpose": {
          "const": "reconcile"
        },
        "credentialPurpose": {
          "const": "reconcile"
        },
        "jti": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "signingKeyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nbf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "installId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "task": {
          "$ref": "urn:pinvou:upgrade:v1:common#/$defs/taskBinding"
        }
      },
      "required": [
        "protocolVersion",
        "role",
        "product",
        "component",
        "scope",
        "credentialType",
        "aud",
        "purpose",
        "credentialPurpose",
        "jti",
        "signingKeyId",
        "iat",
        "nbf",
        "exp",
        "installId",
        "task"
      ],
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "items": {
        "$ref": "urn:pinvou:upgrade:v1:common#/$defs/signature"
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "signed",
    "signatures"
  ],
  "additionalProperties": false
}
