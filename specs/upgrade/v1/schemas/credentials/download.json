{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pinvou:upgrade:v1:credentials:download",
  "type": "object",
  "properties": {
    "signed": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "role": {
          "const": "download"
        },
        "product": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "component": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "scope": {
          "type": "object",
          "properties": {
            "installationScopeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "channel": {
              "enum": [
                "stable",
                "beta",
                "internal"
              ]
            },
            "channelRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "targetKey": {
              "enum": [
                "windows-x86_64-nsis-perMachine",
                "linux-x86_64-deb-perMachine",
                "linux-arm64-deb-perMachine",
                "macos-universal-dmg-perMachine"
              ]
            }
          },
          "required": [
            "installationScopeId",
            "channel",
            "channelRevision",
            "targetKey"
          ],
          "additionalProperties": false
        },
        "credentialType": {
          "const": "download"
        },
        "aud": {
          "const": "upgrade-download-info"
        },
        "purpose": {
          "const": "download"
        },
        "credentialPurpose": {
          "const": "download"
        },
        "jti": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "signingKeyId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nbf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "installId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "decisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "decisionRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "telemetrySessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "currentVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "host": {
          "$ref": "urn:pinvou:upgrade:v1:common#/$defs/host"
        },
        "selectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "metadataSet": {
          "$ref": "urn:pinvou:upgrade:v1:common#/$defs/metadataSet"
        },
        "registryVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceProfileId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clientFactsDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "updaterFactsDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "helperFactsDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "launcherFactsDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "forwardPath": {
          "anyOf": [
            {
              "$ref": "urn:pinvou:upgrade:v1:common#/$defs/pathPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "update": {
          "$ref": "urn:pinvou:upgrade:v1:common#/$defs/updateBinding"
        },
        "packageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "package": {
          "$ref": "urn:pinvou:upgrade:v1:common#/$defs/byteIdentity"
        }
      },
      "required": [
        "protocolVersion",
        "role",
        "product",
        "component",
        "scope",
        "credentialType",
        "aud",
        "purpose",
        "credentialPurpose",
        "jti",
        "signingKeyId",
        "iat",
        "nbf",
        "exp",
        "installId",
        "decisionId",
        "decisionRevision",
        "telemetrySessionId",
        "currentVersion",
        "host",
        "selectionGeneration",
        "metadataSet",
        "registryVersion",
        "sourceProfileId",
        "clientFactsDigest",
        "updaterFactsDigest",
        "helperFactsDigest",
        "launcherFactsDigest",
        "forwardPath",
        "update",
        "packageId",
        "package"
      ],
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "items": {
        "$ref": "urn:pinvou:upgrade:v1:common#/$defs/signature"
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "signed",
    "signatures"
  ],
  "additionalProperties": false
}
