[Service]
# Replace these loopback defaults with your reverse proxy addresses.
# Entries must be literal IPs; anything else aborts startup
# (proxy_ip_configuration_invalid). A blank value means an empty list.
Environment=PINVOU_REMOTE_ALLOWED_PROXY_IPS=127.0.0.1
Environment=PINVOU_REMOTE_TRUSTED_PROXY_IPS=127.0.0.1
Environment=MAX_ENDPOINTS=2000
Environment=ENDPOINT_CREATE_LIMIT=20
Environment=ENDPOINT_CREATE_WINDOW_MS=60000
Environment=MAX_PAYLOAD_BYTES=4194304
Environment=MAX_WS_CONNECTIONS=5000
Environment=WS_CONNECT_LIMIT=120
Environment=WS_CONNECT_WINDOW_MS=60000
Environment=WS_AUTH_TIMEOUT_MS=10000
