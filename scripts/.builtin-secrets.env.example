# 内置工具共享 key —— 复制本文件为同目录 .builtin-secrets.env(gitignored)、填真值。
# npm run build / build:msi / build:nsis 会自动读取并校验；缺项时发布构建直接失败。
#
# release-deb.sh 在 tauri build 前 source 它,key 经 option_env! 编译进二进制。
# 安装内置工具时若用户留空,用这个共享 key 兜底注入 keyring 实现「开箱即用」
# (见 marketplace resolve_secret_placeholder 的共享 key 分支);用户填了自己的 key 则不走兜底。
# 注入时机=安装/启用(非启动全量),所以卸载删 secret 后不会被重新注回。
#
# 提醒:option_env! 会把 key 编进 release 二进制(可逆向提取)——这是「共享额度·可轮换·
# 可限流」的便利用法,不是密钥保护。若 key 有成本/权限风险,应走服务端代理或严格限流可吊销。
#
# 轮换 key 后更新这里、重新跑 release-deb.sh 即可。留空/不建此文件 → 本版无共享 key,
# 新用户装天气/问财/企查查会被引导自己填 key(不影响其他功能)。
export PINVOU3_BUILTIN_AMAP_KEY=""      # 高德天气    控制台 https://console.amap.com
export PINVOU3_BUILTIN_IWENCAI_KEY=""   # 同花顺问财  (问财开放平台)
export PINVOU3_BUILTIN_QCC_KEY=""       # 企查查      控制台 https://agent.qcc.com
