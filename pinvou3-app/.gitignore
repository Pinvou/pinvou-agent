# Tauri 后端构建产物
src-tauri/target/
# Note: src-tauri/Cargo.lock 是 binary crate 应该 commit 的（锁依赖版本）

# 前端依赖（@tauri-apps/cli native binary 等）
node_modules/
# 三省六部网页模板依赖由统一 Tauri wrapper 按当前平台从 lockfile 生成，
# 安装包继续携带离线依赖，但源码仓库不跟踪 node_modules。
src-tauri/resources/**/web-template/node_modules/

# Tauri 生成的快照
src-tauri/gen/

# Codex ACP Bridge 由 prepare-codex-bridge-runtime.sh 按目标平台生成(Linux 规则在仓库根 .gitignore)。
src-tauri/resources/platforms/macos/codex-bridge/node/
src-tauri/resources/platforms/macos/codex-bridge/acp/
src-tauri/resources/platforms/macos/codex-bridge/manifest.json
src-tauri/resources/platforms/macos/.codex-bridge-build.*/

# chrome-devtools-mcp 由 scripts/tauri/chrome-devtools-mcp.js 构建期 vendor(自包含构建,~13MB)。
# 构建机下载 → 三平台 overlay 打进 runtime/chrome-devtools-mcp;dev 下资源缺失时 MCP 条目自动跳过。
src-tauri/resources/platforms/*/chrome-devtools-mcp/

# OS
.DS_Store
Thumbs.db
