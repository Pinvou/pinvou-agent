{
  "id": "iwencai",
  "name": "同花顺问财",
  "description": "A股行情、财务、选股、宏观、新闻 — 12个金融查询工具",
  "version": "1.0.0",
  "icon": "line-chart",
  "category": "金融数据",
  "mcp_tools": [
    "mcp_iwencai_hithink_market_query", "mcp_iwencai_hithink_zhishu_query",
    "mcp_iwencai_hithink_finance_query", "mcp_iwencai_hithink_macro_query",
    "mcp_iwencai_hithink_management_query", "mcp_iwencai_hithink_business_query",
    "mcp_iwencai_hithink_event_query", "mcp_iwencai_hithink_astock_selector",
    "mcp_iwencai_hithink_sector_selector", "mcp_iwencai_hithink_industry_query",
    "mcp_iwencai_news_search", "mcp_iwencai_announcement_search"
  ],
  "command": "python",
  "args": ["server.py"],
  "secret_env": [
    {
      "key": "IWENCAI_API_KEY",
      "provider": "iwencai",
      "required": true
    }
  ],
  "config_fields": [
    { "key": "IWENCAI_API_KEY", "label": "问财 API Key", "required": true, "target": "env", "secret": true }
  ],
  "pip_dependencies": []
}
