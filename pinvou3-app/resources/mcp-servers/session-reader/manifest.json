{
  "id": "session-reader",
  "name": "会话读取",
  "description": "只读、分页读取本机其他 Pinvou 会话的历史记录（配合输入框 @ 引用会话使用）",
  "version": "1.0.0",
  "icon": "message-square",
  "category": "效率工具",
  "mcp_tools": [
    "mcp_session-reader_read_session",
    "mcp_session-reader_list_sessions"
  ],
  "command": "python",
  "args": [
    "server.py"
  ],
  "pip_dependencies": [],
  "builtin": true,
  "visibility": "system",
  "security_level": "L0",
  "data_access": [
    "sessions.read"
  ],
  "tool_features": {
    "mcp_session-reader_read_session": [
      "session-mention",
      "long-memory"
    ],
    "mcp_session-reader_list_sessions": [
      "session-mention",
      "long-memory"
    ]
  }
}
