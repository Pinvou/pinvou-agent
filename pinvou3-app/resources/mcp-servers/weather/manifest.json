{
  "id": "weather",
  "name": "高德天气",
  "description": "查询国内城市实时天气与未来预报，支持天气卡片渲染",
  "version": "1.0.0",
  "icon": "cloud-sun",
  "category": "生活工具",
  "mcp_tools": ["mcp_weather_get_weather"],
  "command": "python",
  "args": ["server.py"],
  "secret_env": [
    {
      "key": "AMAP_KEY",
      "provider": "amap",
      "required": true
    }
  ],
  "config_fields": [
    { "key": "AMAP_KEY", "label": "高德 Web 服务 API Key", "required": true, "target": "env", "secret": true }
  ],
  "pip_dependencies": []
}
