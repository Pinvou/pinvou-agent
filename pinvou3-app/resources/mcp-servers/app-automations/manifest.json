{
  "id": "app-automations",
  "name": "定时任务",
  "description": "在任意会话中创建 Pinvou 定时任务（需逐次确认）并查看已有任务列表；任务与定时任务面板完全一致",
  "version": "1.0.0",
  "icon": "calendar-clock",
  "category": "效率工具",
  "mcp_tools": [
    "mcp_app-automations_create_scheduled_task",
    "mcp_app-automations_list_scheduled_tasks"
  ],
  "command": "python",
  "args": [
    "server.py"
  ],
  "pip_dependencies": [],
  "builtin": true,
  "visibility": "system",
  "security_level": "L1",
  "data_access": [
    "automations.read",
    "automations.write"
  ],
  "tool_features": {
    "mcp_app-automations_create_scheduled_task": [
      "scheduled-task-automation"
    ],
    "mcp_app-automations_list_scheduled_tasks": [
      "scheduled-task-automation"
    ]
  }
}
