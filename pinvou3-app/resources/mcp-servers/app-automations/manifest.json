{
  "id": "app-automations",
  "name": "定时任务",
  "description": "桌面 Operate/Yolo 对话中创建、查看任务，修改名称、模型或暂停状态；删除目标有歧义时先向用户确认；提示词/计划覆盖需在定时任务面板提交。应用需保持运行；Plan/CLI 不支持",
  "version": "1.0.0",
  "icon": "calendar-clock",
  "category": "效率工具",
  "mcp_tools": [
    "mcp_app-automations_create_scheduled_task",
    "mcp_app-automations_read_scheduled_task",
    "mcp_app-automations_list_scheduled_tasks",
    "mcp_app-automations_update_scheduled_task",
    "mcp_app-automations_delete_scheduled_task"
  ],
  "command": "python",
  "args": [
    "server.py"
  ],
  "pip_dependencies": [],
  "builtin": true,
  "visibility": "system",
  "security_level": "L1",
  "data_access": [
    "automations.read",
    "automations.write"
  ],
  "tool_features": {
    "mcp_app-automations_create_scheduled_task": [
      "scheduled-task-automation"
    ],
    "mcp_app-automations_read_scheduled_task": [
      "scheduled-task-automation"
    ],
    "mcp_app-automations_list_scheduled_tasks": [
      "scheduled-task-automation"
    ],
    "mcp_app-automations_update_scheduled_task": [
      "scheduled-task-automation"
    ],
    "mcp_app-automations_delete_scheduled_task": [
      "scheduled-task-automation"
    ]
  }
}
