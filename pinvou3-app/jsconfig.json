{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "checkJs": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "maxNodeModuleJsDepth": 0,
    "types": []
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/vendor/**"
  ]
}