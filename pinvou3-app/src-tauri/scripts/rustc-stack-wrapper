#!/bin/sh
# 仅为 rustc 编译进程注入更大的默认线程栈,规避 macOS 构建 SIGBUS。
#
# 背景:dev 默认对依赖开 O2 + 256 codegen-units 时,rustc/LLVM 编译
# codewhale-tui 会在 MachineLateinstrsCleanup 递归中栈溢出,崩溃为
# SIGBUS(rustc 1.96/1.97 stable 稳定复现;上游 v0.9.0 无此问题,
# 属 v0.9.5 升级引入的构建回归)。
#
# 通过 .cargo/config.toml [build] rustc-wrapper 接入,只包装编译期
# rustc 调用;cargo run / cargo test 启动的应用与测试进程不经过本脚本,
# 不会继承 RUST_MIN_STACK,默认线程栈语义(约 2 MiB)不变。
# 仅 macOS(Darwin)需要规避;其他平台原样透传,构建行为不变。
# 与 rust-lang/rust #160535(默认栈提升到 16 MiB)同方向。
case "$(uname -s)" in
  Darwin) export RUST_MIN_STACK="${RUST_MIN_STACK:-16777216}" ;;
esac
exec "$@"
