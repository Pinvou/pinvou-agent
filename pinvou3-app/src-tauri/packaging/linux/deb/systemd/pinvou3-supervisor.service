[Unit]
Description=PinvouOS Host Supervisor
Requires=pinvou3-supervisor.socket
After=pinvou3-supervisor.socket
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/lib/pinvou3/supervisor/pinvou-supervisor daemon
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
Slice=app.slice
TasksMax=64
MemoryMax=256M
OOMPolicy=stop
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pinvou-supervisor
StateDirectory=pinvou-supervisor
StateDirectoryMode=0700
Environment=PINVOU_SUPERVISOR_STATE_DIR=%S/pinvou-supervisor
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelTunables=yes
# Do not set ProtectKernelModules= for this user unit. The service already lacks
# CAP_SYS_MODULE and cannot gain it (NoNewPrivileges + RestrictSUIDSGID), while
# systemd 259 can otherwise fail before exec with status 218/CAPABILITIES.
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
