#!/bin/sh
# 品悟 EIP CLI 包装(Linux/macOS)。
# 模型 shell 工具的环境被白名单消毒(见 EIP 接入方案 §2.5),AGENT_* 直接继承会被丢弃,
# 故在子进程内部注入再 exec 真正的 eip-cli。device_id / credentials 与 pinvou3 的
# eip.rs 共用同一份(~/.pinvou3/eip/),确保登录(tauri 调)与业务(本脚本)登录态一致。
d="$HOME/.pinvou3/eip"
if [ -f "$d/device_id" ]; then
  AGENT_DEVICE_ID="$(cat "$d/device_id")"
  export AGENT_DEVICE_ID
fi
export AGENT_CREDENTIALS_DIR="$d/credentials"
export AGENT_NON_INTERACTIVE=1
bin_dir="$(dirname "$0")"
cli="$bin_dir/eip-cli"
case "$(uname -m 2>/dev/null)" in
  aarch64|arm64)
    if [ -f "$bin_dir/eip-cli-aarch64" ]; then
      cli="$bin_dir/eip-cli-aarch64"
    fi
    ;;
esac
exec "$cli" "$@"
