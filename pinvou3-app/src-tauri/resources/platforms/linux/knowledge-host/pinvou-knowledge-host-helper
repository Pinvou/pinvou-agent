#!/bin/sh
set -eu

SERVICE=pinvou-knowledge.service
DATA_DIR=/var/lib/pinvou-knowledge
MODEL_MOUNT=/var/lib/pinvou-knowledge-model
INSTALL_DIR=/usr/lib/pinvou
INSTALL_BIN=$INSTALL_DIR/pinvou-knowledge-server
UNIT_FILE=/etc/systemd/system/$SERVICE
UNIT_BACKUP=$UNIT_FILE.previous

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || fail "需要管理员权限"
[ "$(uname -s)" = Linux ] || fail "仅支持 Linux"

secure_packaged_file() {
  path=$1
  [ -f "$path" ] || fail "安装包资源不存在"
  owner=$(stat -c %u "$path" 2>/dev/null) || fail "无法检查安装包资源"
  mode=$(stat -c %a "$path" 2>/dev/null) || fail "无法检查安装包资源权限"
  [ "$owner" -eq 0 ] || fail "请使用正式安装的 PINVOU 创建共享知识库"
  case "$mode" in
    *[2367][0-9]|*[0-9][2367]) fail "安装包资源权限不安全" ;;
  esac
}

write_unit() {
  service_uid=$1
  service_gid=$2
  model_dir=$3
  cat >"$UNIT_FILE.new" <<EOF
[Unit]
Description=PINVOU shared knowledge host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$service_uid
Group=$service_gid
StateDirectory=pinvou-knowledge
StateDirectoryMode=0700
WorkingDirectory=/var/lib/pinvou-knowledge
ExecStart=/usr/lib/pinvou/pinvou-knowledge-server --bind 0.0.0.0:3210 --data-dir /var/lib/pinvou-knowledge --model-dir $MODEL_MOUNT
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=$model_dir:$MODEL_MOUNT
ReadWritePaths=/var/lib/pinvou-knowledge $MODEL_MOUNT
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
EOF
  chmod 0644 "$UNIT_FILE.new"
  mv -f "$UNIT_FILE.new" "$UNIT_FILE"
}

validate_data_dir() {
  [ -e "$DATA_DIR" ] || return 0
  [ -d "$DATA_DIR" ] || fail "共享知识库数据路径不是目录"
  [ ! -L "$DATA_DIR" ] || fail "拒绝使用符号链接数据目录"
  resolved=$(readlink -f "$DATA_DIR" 2>/dev/null || true)
  [ "$resolved" = "$DATA_DIR" ] || fail "共享知识库数据目录异常"
}

model_complete() {
  root=$1
  { [ -f "$root/model.onnx" ] || [ -f "$root/onnx/model_int8.onnx" ]; } &&
    [ -f "$root/tokenizer.json" ] &&
    [ -f "$root/config.json" ] &&
    [ -f "$root/special_tokens_map.json" ] &&
    [ -f "$root/tokenizer_config.json" ]
}

rollback_install() {
  [ "${rollback_pending:-0}" -eq 1 ] || return 0
  rollback_pending=0
  trap - EXIT HUP INT TERM
  systemctl stop "$SERVICE" >/dev/null 2>&1 || true
  if [ "${had_binary:-0}" -eq 1 ] && [ -f "$INSTALL_BIN.previous" ]; then
    mv -f "$INSTALL_BIN.previous" "$INSTALL_BIN"
  else
    rm -f "$INSTALL_BIN"
  fi
  if [ "${had_unit:-0}" -eq 1 ] && [ -f "$UNIT_BACKUP" ]; then
    mv -f "$UNIT_BACKUP" "$UNIT_FILE"
  else
    rm -f "$UNIT_FILE"
  fi
  if [ "${had_data:-0}" -eq 1 ]; then
    chown -R "${old_data_uid}:${old_data_gid}" "$DATA_DIR" >/dev/null 2>&1 || true
  fi
  systemctl daemon-reload >/dev/null 2>&1 || true
  if [ "${was_enabled:-0}" -eq 1 ]; then
    systemctl enable "$SERVICE" >/dev/null 2>&1 || true
  else
    systemctl disable "$SERVICE" >/dev/null 2>&1 || true
  fi
  if [ "${was_active:-0}" -eq 1 ]; then
    systemctl restart "$SERVICE" >/dev/null 2>&1 || true
  fi
}

restart_service_after_maintenance() {
  [ "${maintenance_restart_pending:-0}" -eq 1 ] || return 0
  maintenance_restart_pending=0
  trap - EXIT HUP INT TERM
  systemctl start "$SERVICE" >/dev/null 2>&1 || true
}

begin_service_maintenance() {
  maintenance_restart_pending=1
  trap 'restart_service_after_maintenance' EXIT
  trap 'restart_service_after_maintenance; exit 129' HUP
  trap 'restart_service_after_maintenance; exit 130' INT
  trap 'restart_service_after_maintenance; exit 143' TERM
  systemctl stop "$SERVICE"
}

finish_service_maintenance() {
  failure_message=$1
  if ! systemctl start "$SERVICE"; then
    fail "$failure_message"
  fi
  maintenance_restart_pending=0
  trap - EXIT HUP INT TERM
}

install_or_upgrade() {
  source_bin=$1
  model_dir=$2
  service_uid=$3
  service_gid=$4
  secure_packaged_file "$source_bin"
  case "$model_dir" in
    /*) ;;
    *) fail "模型目录无效" ;;
  esac
  case "$model_dir" in
    *[!A-Za-z0-9_./-]*|*:*|*' '*|*'	'*) fail "模型目录包含不支持的字符" ;;
  esac
  case "$service_uid:$service_gid" in
    *[!0-9:]*|0:*|*:0) fail "宿主用户无效" ;;
  esac
  passwd_entry=$(getent passwd "$service_uid") || fail "宿主用户不存在"
  user_home=$(printf '%s' "$passwd_entry" | cut -d: -f6)
  case "$model_dir" in
    "$user_home"/.pinvou3/knowledge/models/bge-m3) ;;
    *) fail "模型目录不属于当前 PINVOU 用户" ;;
  esac

  validate_data_dir
  had_data=0
  old_data_uid=$service_uid
  old_data_gid=$service_gid
  if [ -d "$DATA_DIR" ]; then
    had_data=1
    old_data_uid=$(stat -c %u "$DATA_DIR") || fail "无法检查共享知识库数据目录"
    old_data_gid=$(stat -c %g "$DATA_DIR") || fail "无法检查共享知识库数据目录"
  fi
  had_unit=0
  [ -f "$UNIT_FILE" ] && {
    cp -p "$UNIT_FILE" "$UNIT_BACKUP"
    had_unit=1
  }
  had_binary=0
  [ -f "$INSTALL_BIN" ] && {
    cp -p "$INSTALL_BIN" "$INSTALL_BIN.previous"
    had_binary=1
  }
  was_enabled=0
  systemctl is-enabled --quiet "$SERVICE" >/dev/null 2>&1 && was_enabled=1
  was_active=0
  systemctl is-active --quiet "$SERVICE" >/dev/null 2>&1 && was_active=1
  rollback_pending=1
  trap 'rollback_install' EXIT HUP INT TERM

  install -d -m 0755 -o root -g root "$INSTALL_DIR"
  install -d -m 0700 -o "$service_uid" -g "$service_gid" "$DATA_DIR"
  install -d -m 0700 -o "$service_uid" -g "$service_gid" "$model_dir"
  install -d -m 0755 -o root -g root "$MODEL_MOUNT"
  chown -R "$service_uid:$service_gid" "$DATA_DIR"
  legacy_model=$DATA_DIR/models/bge-m3
  if ! model_complete "$model_dir" && model_complete "$legacy_model"; then
    cp -a "$legacy_model/." "$model_dir/"
    chown -R "$service_uid:$service_gid" "$model_dir"
  fi
  install -m 0755 -o root -g root "$source_bin" "$INSTALL_BIN.new"
  mv -f "$INSTALL_BIN.new" "$INSTALL_BIN"
  write_unit "$service_uid" "$service_gid" "$model_dir"
  systemctl daemon-reload
  systemctl enable "$SERVICE" >/dev/null
  systemctl restart "$SERVICE" || fail "共享知识库服务启动失败，正在恢复旧版本"
  attempts=0
  while [ "$attempts" -lt 30 ]; do
    if "$INSTALL_BIN" --health-check https://127.0.0.1:3210 >/dev/null 2>&1; then
      rollback_pending=0
      trap - EXIT HUP INT TERM
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 1
  done
  fail "共享知识库服务健康检查失败，正在恢复旧版本"
}

claim_owner() {
  claim=$DATA_DIR/host-owner.claim
  [ -s "$claim" ] || fail "没有可领取的本机所有者凭据"
  cat "$claim"
  rm -f "$claim"
}

show_owner_claim() {
  claim=$DATA_DIR/host-owner.claim
  [ -s "$claim" ] || fail "没有可领取的本机所有者凭据"
  cat "$claim"
}

set_owner_device() {
  device_id=$1
  scope=$2
  service_uid=$3
  service_gid=$4
  case "$device_id" in
    ''|*[!A-Za-z0-9_-]*) fail "成员设备无效" ;;
  esac
  case "$scope" in owner|manage) ;; *) fail "所有者权限无效" ;; esac
  case "$service_uid:$service_gid" in
    *[!0-9:]*|0:*|*:0) fail "宿主用户无效" ;;
  esac
  getent passwd "$service_uid" >/dev/null 2>&1 || fail "宿主用户不存在"
  command -v setpriv >/dev/null 2>&1 || fail "系统缺少 setpriv，无法安全修改所有者"
  [ -x "$INSTALL_BIN" ] || fail "共享知识库服务未安装"
  begin_service_maintenance
  if ! result=$(setpriv --reuid "$service_uid" --regid "$service_gid" --clear-groups -- \
      "$INSTALL_BIN" --data-dir "$DATA_DIR" --host-owner-device "$device_id" \
      --host-owner-scope "$scope"); then
    fail "修改所有者失败"
  fi
  finish_service_maintenance "所有者已修改，但共享知识库服务未能重新启动"
  printf '%s\n' "$result"
}

recover_owner() {
  source_bin=$1
  service_uid=$2
  service_gid=$3
  secure_packaged_file "$source_bin"
  validate_data_dir
  case "$service_uid:$service_gid" in
    *[!0-9:]*|0:*|*:0) fail "宿主用户无效" ;;
  esac
  getent passwd "$service_uid" >/dev/null 2>&1 || fail "宿主用户不存在"
  command -v setpriv >/dev/null 2>&1 || fail "系统缺少 setpriv，无法安全恢复所有者"
  [ -x "$INSTALL_BIN" ] || fail "共享知识库服务未安装"
  begin_service_maintenance
  if ! result=$(setpriv --reuid "$service_uid" --regid "$service_gid" --clear-groups -- \
      "$source_bin" --data-dir "$DATA_DIR" \
      --recover-host-owner-claim "$DATA_DIR/host-owner.claim"); then
    fail "恢复本机所有者失败"
  fi
  finish_service_maintenance "本机所有者已恢复，但共享知识库服务未能重新启动"
  attempts=0
  while [ "$attempts" -lt 30 ]; do
    if "$INSTALL_BIN" --health-check https://127.0.0.1:3210 >/dev/null 2>&1; then
      printf '%s\n' "$result"
      return 0
    fi
    attempts=$((attempts + 1))
    sleep 1
  done
  fail "本机所有者已恢复，但共享知识库服务尚未就绪"
}

validate_service_identity() {
  service_uid=$1
  service_gid=$2
  case "$service_uid:$service_gid" in
    *[!0-9:]*|0:*|*:0) fail "宿主用户无效" ;;
  esac
  getent passwd "$service_uid" >/dev/null 2>&1 || fail "宿主用户不存在"
  command -v setpriv >/dev/null 2>&1 || fail "系统缺少 setpriv，无法安全执行备份操作"
  [ -x "$INSTALL_BIN" ] || fail "共享知识库服务未安装"
}

backup_host() {
  output=$1
  local_recipient=$2
  recovery_recipient=$3
  service_uid=$4
  service_gid=$5
  validate_service_identity "$service_uid" "$service_gid"
  case "$output" in /*) ;; *) fail "备份路径无效" ;; esac
  begin_service_maintenance
  if ! result=$(setpriv --reuid "$service_uid" --regid "$service_gid" --clear-groups -- \
      "$INSTALL_BIN" --data-dir "$DATA_DIR" --backup-output "$output" \
      --backup-recipient "$local_recipient" --backup-recipient "$recovery_recipient"); then
    fail "创建加密备份失败"
  fi
  finish_service_maintenance "备份已完成，但共享知识库服务未能重新启动"
  printf '%s\n' "$result"
}

restore_host() {
  input=$1
  identity_file=$2
  mode=$3
  service_uid=$4
  service_gid=$5
  validate_service_identity "$service_uid" "$service_gid"
  case "$input:$identity_file" in /*:/*) ;; *) fail "恢复路径无效" ;; esac
  [ -f "$input" ] || fail "备份文件不存在"
  [ -f "$identity_file" ] || fail "恢复密钥不存在"
  identity_owner=$(stat -c %u "$identity_file" 2>/dev/null) || fail "无法检查恢复密钥"
  identity_mode=$(stat -c %a "$identity_file" 2>/dev/null) || fail "无法检查恢复密钥权限"
  [ "$identity_owner" -eq "$service_uid" ] || fail "恢复密钥不属于当前 PINVOU 用户"
  case "$identity_mode" in *[1-7][0-9]|*[0-9][1-7]) fail "恢复密钥权限不安全" ;; esac
  case "$mode" in same-host|content-only) ;; *) fail "恢复模式无效" ;; esac
  begin_service_maintenance
  if ! result=$(setpriv --reuid "$service_uid" --regid "$service_gid" --clear-groups -- \
      "$INSTALL_BIN" --data-dir "$DATA_DIR" --restore-input "$input" \
      --restore-identity-file "$identity_file" --restore-mode "$mode"); then
    fail "恢复共享知识库失败，原数据未被替换"
  fi
  finish_service_maintenance "数据已恢复，但共享知识库服务未能重新启动"
  printf '%s\n' "$result"
  if [ "$mode" = content-only ] && [ -s "$DATA_DIR/host-owner.claim" ]; then
    show_owner_claim
  fi
}

remove_host() {
  mode=$1
  systemctl disable --now "$SERVICE" >/dev/null 2>&1 || true
  rm -f "$UNIT_FILE" "$INSTALL_BIN" "$INSTALL_BIN.previous"
  rmdir "$MODEL_MOUNT" >/dev/null 2>&1 || true
  systemctl daemon-reload
  if [ "$mode" = delete-data ]; then
    [ -e "$DATA_DIR" ] || return 0
    resolved=$(readlink -f "$DATA_DIR" 2>/dev/null || true)
    [ "$resolved" = "$DATA_DIR" ] || fail "拒绝删除异常的数据目录"
    rm -rf -- "$DATA_DIR"
  elif [ "$mode" != keep-data ]; then
    fail "移除模式无效"
  fi
}

action=${1:-}
case "$action" in
  install|upgrade)
    [ "$#" -eq 5 ] || fail "安装参数无效"
    install_or_upgrade "$2" "$3" "$4" "$5"
    [ -s "$DATA_DIR/host-owner.claim" ] && show_owner_claim || true
    ;;
  claim-owner)
    [ "$#" -eq 1 ] || fail "领取参数无效"
    claim_owner
    ;;
  set-owner)
    [ "$#" -eq 5 ] || fail "所有者参数无效"
    set_owner_device "$2" "$3" "$4" "$5"
    ;;
  recover-owner)
    [ "$#" -eq 4 ] || fail "恢复所有者参数无效"
    recover_owner "$2" "$3" "$4"
    ;;
  backup)
    [ "$#" -eq 6 ] || fail "备份参数无效"
    backup_host "$2" "$3" "$4" "$5" "$6"
    ;;
  restore)
    [ "$#" -eq 6 ] || fail "恢复参数无效"
    restore_host "$2" "$3" "$4" "$5" "$6"
    ;;
  remove)
    [ "$#" -eq 2 ] || fail "移除参数无效"
    remove_host "$2"
    ;;
  *) fail "未知操作" ;;
esac
