{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pinvou3",
  "mainBinaryName": "pinvou3-tauri",
  "version": "0.6.3",
  "identifier": "com.pinvou.pinvou3",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "npm run validate:pet-assets -- --release && vite build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html?ui=vite-react-1",
        "title": "PINVOU 智能助手",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/web-template/": "web-template"
    }
  }
}
