{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pinvou3",
  "version": "0.1.1",
  "identifier": "com.pinvou.pinvou3",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "pinvou3 智能助手",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
