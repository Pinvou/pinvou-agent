{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pinvou3",
  "mainBinaryName": "pinvou3-tauri",
  "version": "0.5.6",
  "identifier": "com.pinvou.pinvou3",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PINVOU 智能助手（内测版）",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/web-template/": "web-template",
      "resources/asr/": "asr",
      "resources/windows/poppler/": "poppler",
      "resources/windows/pandoc/": "pandoc",
      "resources/windows/tesseract/": "tesseract",
      "resources/windows/asr/README.md": "asr/README.md",
      "resources/windows/asr/pinvou-asr.exe": "asr/pinvou-asr.exe",
      "resources/windows/asr/llama-funasr-sensevoice.exe": "asr/llama-funasr-sensevoice.exe",
      "resources/windows/asr/models/fsmn-vad.gguf": "asr/models/fsmn-vad.gguf",
      "resources/windows/7zip/": "7zip"
    },
    "windows": {
      "wix": {
        "template": "resources/windows/main.wxs",
        "fragmentPaths": [
          "resources/windows/poppler-path.wxs",
          "resources/windows/pandoc-path.wxs",
          "resources/windows/tesseract-path.wxs",
          "resources/windows/7zip-path.wxs"
        ],
        "componentRefs": [
          "PopplerPathEnvironment",
          "PandocPathEnvironment",
          "TesseractPathEnvironment",
          "SevenZipPathEnvironment"
        ]
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "resources/windows/nsis/installer-hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "compression": "lzma"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "desktop/pinvou3.desktop",
        "postInstallScript": "scripts/postinst.sh",
        "preRemoveScript": "scripts/prerm.sh",
        "depends": [],
        "recommends": [
          "poppler-utils",
          "tesseract-ocr",
          "tesseract-ocr-chi-sim",
          "pandoc",
          "p7zip-full",
          "python3",
          "libreoffice",
          "libemail-outlook-message-perl"
        ]
      }
    }
  }
}
