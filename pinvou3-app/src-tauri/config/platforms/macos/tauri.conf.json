{
  "$schema": "../../../../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html?ui=vite-react-1",
        "title": "PINVOU 智能助手",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "dragDropEnabled": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 20 }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": {
      "resources/platforms/macos/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy",
      "resources/platforms/macos/codex-bridge/": "runtime/codex-bridge",
      "resources/platforms/macos/chrome-devtools-mcp/": "runtime/chrome-devtools-mcp",
      "resources/platforms/macos/infoplist/": "./"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "packaging/macos/entitlements.plist",
      "infoPlist": "packaging/macos/Info.plist"
    }
  }
}
