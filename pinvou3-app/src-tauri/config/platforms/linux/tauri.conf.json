          "/usr/lib/systemd/user/pinvou3-supervisor.service": "packaging/linux/deb/systemd/pinvou3-supervisor.service",
          "/usr/lib/systemd/user/pinvou3-app.service": "packaging/linux/deb/systemd/pinvou3-app.service",
