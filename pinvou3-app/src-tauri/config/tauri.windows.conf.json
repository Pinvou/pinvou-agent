{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "targets": ["msi"],
    "windows": {
      "wix": {
        "template": "packaging/windows/main.wxs",
        "fragmentPaths": [
          "packaging/windows/python-node-path.wxs"
        ],
        "componentRefs": [
          "PythonNodeRuntimeEnvironment"
        ]
      },
      "nsis": {
        "installMode": "perMachine",
        "template": "packaging/windows/nsis/installer-template.nsi",
        "installerHooks": "packaging/windows/nsis/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "compression": "lzma"
      }
    }
  }
}
