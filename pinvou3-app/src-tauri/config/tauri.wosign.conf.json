{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "windows": {
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "packaging/windows/wosign/sign.ps1",
          "-FilePath",
          "%1"
        ]
      }
    }
  }
}
