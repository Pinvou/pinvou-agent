+    fn zip_path_cache_accepts_result_names() -> zip::result::ZipResult<()> {
+        use std::io::Write;
+        let mut writer = zip::ZipWriter::new(std::io::Cursor::new(Vec::new()));
+        for name in ["XL\\SHEET.XML", "é.xml"] {
+            writer.start_file(name, zip::write::SimpleFileOptions::default())?;
+            writer.write_all(b"content")?;
+        }
+        let archive = zip::ZipArchive::new(writer.finish()?)?;
+        let names = archive
+            .file_names()
+            .collect::<zip::result::ZipResult<Vec<_>>>()?;
+        assert_eq!(names.len(), 2);
+        let cache = build_zip_path_cache(&archive)?;
+        assert_eq!(
+            cache.get("xl/sheet.xml").map(String::as_str),
+            Some("XL\\SHEET.XML")
+        );
+        assert_eq!(cache.get("é.xml").map(String::as_str), Some("é.xml"));
+        Ok(())
+    }
